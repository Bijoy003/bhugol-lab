@page "/blog/{slug}"
@model BhugolLab.Web.Pages.Blog.PostModel
@{
    var item = Model.Item;
}

<article class="page-narrow">
    <header class="post-header">
        <p class="eyebrow">Blog</p>
        <h1>@item.Title</h1>
        <p class="post-meta">
            <time datetime="@item.Date.ToString("yyyy-MM-dd")">@item.Date.ToString("MMMM d, yyyy")</time>
            @if (item.Tags.Count > 0)
            {
                <text> · </text>
                <span class="tag-list">
                    @foreach (var tag in item.Tags)
                    {
                        <a class="tag" asp-page="/Blog/Tag" asp-route-tag="@tag">@tag</a>
                    }
                </span>
            }
        </p>
    </header>

    @if (item.Toc.Count > 0)
    {
        <nav class="toc" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <ol>
                @foreach (var entry in item.Toc)
                {
                    <li class="toc-level-@entry.Level"><a href="#@entry.Id">@entry.Text</a></li>
                }
            </ol>
        </nav>
    }

    <div class="prose">
        @Html.Raw(item.Html)
    </div>

    <hr />
    <p><a asp-page="/Blog/Index">← All posts</a></p>
</article>
