@page
@model ErrorModel
@{
    ViewData["Title"] = "error";
    ViewData["Description"] = "An unexpected error occurred.";
}
<div class="page-narrow">
    <h1>Something went wrong</h1>
    <p>
        Sorry — an unexpected error occurred while handling your request.
        Nothing you did caused it. Please try again, or head
        <a asp-page="/Index">back to the homepage</a>.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="small muted">
            Request ID: <code>@Model.RequestId</code> — mention it if you report the problem.
        </p>
    }
</div>
