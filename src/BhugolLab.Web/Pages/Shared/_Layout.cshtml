@using BhugolLab.Web.Options
@using Microsoft.Extensions.Options
@inject IOptions<SiteOptions> SiteOptionsAccessor
@inject IOptions<EmailOptions> EmailOptionsAccessor
@{
    var site = SiteOptionsAccessor.Value;
    var email = EmailOptionsAccessor.Value;
    var request = ViewContext.HttpContext.Request;

    var titleSuffix = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(titleSuffix)
        ? "Bhugol Lab — solo software consultancy"
        : $"Bhugol Lab — {titleSuffix}";

    var description = ViewData["Description"] as string ??
        "Bhugol Lab is the solo software consultancy of " + site.AuthorName + ". TODO: positioning line.";

    var canonicalPath = request.Path.HasValue ? request.Path.Value! : "/";
    var baseUrl = site.BaseUrl.TrimEnd('/');
    var canonical = canonicalPath == "/" ? baseUrl + "/" : baseUrl + canonicalPath;

    var ogType = ViewData["OgType"] as string ?? "website";
    var ogImage = ViewData["OgImage"] as string ?? "/img/og/default.png";
    var ogImageAbsolute = ogImage.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ogImage : baseUrl + ogImage;

    bool IsPlaceholder(string? value) => string.IsNullOrWhiteSpace(value) || value.Contains("TODO", StringComparison.OrdinalIgnoreCase);
    var currentPath = request.Path.Value ?? "/";
    string? CurrentFor(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="Bhugol Lab" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImageAbsolute" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImageAbsolute" />
    <meta name="theme-color" content="#1a56db" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="~/img/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Bhugol Lab blog" href="@baseUrl/rss.xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["JsonLd"] is string jsonLd && jsonLd.Length > 0)
    {
        @* Raw on purpose: the JSON is escaped by System.Text.Json (including < as \u003C),
           and Razor would otherwise HTML-encode the "+" in the MIME type. *@
        @Html.Raw("<script type=\"application/ld+json\">" + jsonLd + "</script>")
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="wordmark" href="/">Bhugol Lab</a>
            <nav class="site-nav" aria-label="Main">
                <a asp-page="/Services" aria-current="@CurrentFor("/services")">Services</a>
                <a asp-page="/Work/Index" aria-current="@CurrentFor("/work")">Work</a>
                <a asp-page="/Blog/Index" aria-current="@CurrentFor("/blog")">Blog</a>
                <a asp-page="/Contact" aria-current="@CurrentFor("/contact")">Contact</a>
                @if (IsPlaceholder(site.BookingUrl))
                {
                    <a class="button button-primary" asp-page="/Hire">Hire me</a>
                }
                else
                {
                    <a class="button button-primary" href="@site.BookingUrl" rel="noopener">Book a call</a>
                }
            </nav>
        </div>
    </header>
    <main id="main" class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <p class="mt-0"><strong>Bhugol Lab</strong> — @site.AuthorName</p>
                <p class="small mt-0">
                    @if (IsPlaceholder(site.Location))
                    {
                        <span class="todo">TODO: city / timezone</span>
                    }
                    else
                    {
                        @site.Location
                    }
                    · Traffic is measured with Cloudflare zone analytics — no cookies, no third-party scripts.
                </p>
            </div>
            <div class="footer-links">
                @if (IsPlaceholder(email.ToAddress))
                {
                    <span class="todo">TODO: contact email</span>
                }
                else
                {
                    <a href="mailto:@email.ToAddress">@email.ToAddress</a>
                }
                @if (!IsPlaceholder(site.GitHubUrl))
                {
                    <a href="@site.GitHubUrl" rel="noopener me">GitHub</a>
                }
                @if (!IsPlaceholder(site.LinkedInUrl))
                {
                    <a href="@site.LinkedInUrl" rel="noopener me">LinkedIn</a>
                }
                <a asp-page="/Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
